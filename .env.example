# ============================================================
# DJANGO
# ============================================================
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=America/Sao_Paulo

# ============================================================
# POSTGRESQL
# ============================================================
POSTGRES_DB=ksc_action_center
POSTGRES_USER=ksc_action
POSTGRES_PASSWORD=TroqueEstaSenha
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ============================================================
# CLIENTE INICIAL
# ============================================================
DEFAULT_CUSTOMER_CODE=BONJA
DEFAULT_CUSTOMER_NAME=BONJA

# ============================================================
# KASPERSKY SECURITY CENTER OPENAPI
# Nao versionar credenciais reais.
# ============================================================
KSC_HOST=antivirus.bonja.local
KSC_PORT=13299
KSC_USERNAME=api_relatorio
KSC_PASSWORD=COLOQUE_A_SENHA_AQUI
KSC_INTERNAL_USER=true
KSC_DOMAIN=bonja.local

# true = valida TLS; false = somente laboratorio.
KSC_VERIFY_SSL=true

# Se utilizar a CA exportada do KSC, informe o caminho.
# Exemplo Windows:
# KSC_CA_CERT=C:\KSC_Action_Center\certs\klserver.pem
KSC_CA_CERT=

KSC_TIMEOUT=30
KSC_HOST_FILTER=(&(KLHST_WKS_FROM_UNASSIGNED=0)(KLHST_WKS_DN="*"))
KSC_CURRENT_VSERVER_ONLY=true
